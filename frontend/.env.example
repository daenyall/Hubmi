# Publiczny adres FastAPI, bez końcowego /api. Żadne sekrety nie są potrzebne.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Wyłącznie dokładne "true" włącza fikcyjne dane demonstracyjne.
# Przy false frontend wysyła POST /api/match i nie przełącza się na mock po błędzie.
NEXT_PUBLIC_USE_MOCK_MATCHING=false

# Publiczna konfiguracja Supabase do rzeczywistego Auth i zapisu fiszek.
# Wartości dostarcza osoba A. Nigdy nie wpisuj service_role / sb_secret_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatywnie starszy publiczny JWT z role=anon:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Włącz dopiero po wdrożeniu schematu i prywatnych RLS przez A.
# Szczegóły: docs/submissions-contract.md. To nie jest tryb mock.
NEXT_PUBLIC_SUBMISSIONS_ENABLED=false

# Etap 3: po uzgodnieniu docs/stage-3-contract.md i wdrożeniu roli/triggera/RLS.
# Nie nadaje roli ROPS i nie włącza mocków. Domyślnie blokuje panel i komunikację.
NEXT_PUBLIC_ROPS_COMMUNICATION_ENABLED=false
