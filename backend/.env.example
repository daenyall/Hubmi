# FastAPI App Settings
APP_NAME=Hubmi Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
WORKERS=1
# CORS: lista JSON lub rozdzielone przecinkami (np. http://localhost:3000,https://hubmi.vercel.app)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# AI Settings (OpenAI lub darmowy Google Gemini)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash
